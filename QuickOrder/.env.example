# Copy to .env in QuickOrder and fill the two values locally.
# Use a Brevo API key (not an SMTP key) and a sender verified in your Brevo account.
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=QuickOrder
MAIL_CONSOLE=0
# For localhost HTTP only. On Render set HTTPS=1 in service Environment.
HTTPS=0

# Stable signing key, required on real deployments (generate with secrets.token_hex(32)).
SECRET_KEY=
# Optional separate Fernet key; if blank, derive from the stable SECRET_KEY above.
PAYMENT_ENCRYPTION_KEY=
# Background reconciliation starts automatically in the web process.
PAYMENT_WORKER=1
# Optional external scheduler, not required for local/normal web worker.
PAYMENT_RECONCILE_SECRET=
# Legacy only: XAPI_SHOP_<id> is still read for old setups until owners configure the bank on the web.
# New owners use Merchant > Bank & payments; no per-shop .env token is needed.
